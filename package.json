{
  "name": "seller-audit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "local:server": "node --experimental-strip-types server/index.ts",
    "local:migrate": "node --experimental-strip-types server/migrate.ts",
    "local:bootstrap-admin": "node --experimental-strip-types server/bootstrap.ts",
    "test:local:db": "node server/tests/run-pglite.mjs node_modules/@electric-sql/pglite/dist/index.js && node server/tests/local_6b_parity.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "playwright test --config playwright.unit.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:supabase": "playwright test --config playwright.supabase.config.ts",
    "test:e2e:local": "playwright test --config playwright.local.config.ts",
    "test:e2e:local-integration": "playwright test --config playwright.local.integration.config.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/rate-limit": "11.2.1",
    "@supabase/supabase-js": "2.118.0",
    "argon2": "0.45.1",
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2"
  }
}
